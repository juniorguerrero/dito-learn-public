# Claude (orchestration + all script/spec generation)
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-sonnet-5)
CLAUDE_MODEL=

# RunPod Flash media endpoints.
# Each value can be a bare endpoint id (e.g. abc123def) OR a full /runsync URL.
# Deploy the workers in ./runpod-workers (see its README), then paste the ids here.
# Leave empty for local dev: the app falls back to mock images/audio so every UI works.
RUNPOD_API_KEY=
RUNPOD_IMAGE_ENDPOINT=
RUNPOD_TTS_ENDPOINT=
RUNPOD_MUSIC_ENDPOINT=
RUNPOD_VIDEO_ENDPOINT=
# Polling for slow async jobs (video/music)
RUNPOD_REQUEST_TIMEOUT_SECONDS=
RUNPOD_POLL_INTERVAL_SECONDS=

# Kokoro voice names (optional)
KOKORO_TEACHER_VOICE=
KOKORO_STUDENT_VOICE=
KOKORO_NARRATOR_VOICE=

# EverMind (EverOS cloud) long-term memory — https://docs.evermind.ai
# Powers the Raven-style agent harness (recall → reason → remember): every
# teacher↔student message, tutor question and learning event is remembered,
# so the professor's AI knows everything happening over time.
# Get a key at everos.evermind.ai. Leave empty: memory becomes a silent no-op.
EVERMIND_API_KEY=

# Supabase (optional — MVP uses a local JSON store in ./data)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
